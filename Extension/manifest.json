{
  "manifest_version": 2,
  "name": "Kotone Bridge",
  "version": "0.18.0",
  "description": "Kotone のネイティブ UI と YouTube Music のページを繋ぐ内部用アドオン。",
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@kotone.example.com",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "tabs",
    "*://music.youtube.com/*",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "kotone-config.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*",
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}